{
  "name": "@justmiles/wasmkit",
  "version": "0.1.5",
  "description": "React hooks, workers, and Vite plugin for Go/WASM apps with OPFS-backed SQLite",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vite-plugin": {
      "types": "./dist/vite-plugin.d.ts",
      "import": "./dist/vite-plugin.js"
    },
    "./workers/*": "./dist/workers/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "vite": {
      "optional": true
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}